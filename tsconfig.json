{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["vendor/osrs-dps-calc/src/*"],
      "~/*": ["src/*"],
      "next/image": ["src/shims/next-image.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "scripts/check.ts"]
}
